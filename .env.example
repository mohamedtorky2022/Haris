# Copy to .env and fill in. Never commit the real .env file.

# Optional: turns on the AI. Without a key Haris runs on rules only.
# Claude (Claude Console API key; Max plans include monthly API credits):
ANTHROPIC_API_KEY=
# or Gemini (free tier, key from https://aistudio.google.com/apikey):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# When both keys are set, choose one: anthropic or gemini.
HARIS_AI_PROVIDER=

# Optional: model used for the AI second opinion.
HARIS_MODEL=claude-haiku-5-5

# Optional: seconds to wait for the AI before falling back to rules.
HARIS_LLM_TIMEOUT=12

# Requests per minute allowed per client on /api/*. 0 turns the limit off.
HARIS_RATE_LIMIT=30

# Campaign radar (demo). Reports are kept in data/radar.db, which is never committed.
# Without a token the authority dashboard (/authority.html) opens only on this computer.
HARIS_AUTHORITY_TOKEN=
HARIS_RADAR_WARN=3
HARIS_RADAR_ESCALATE=10
HARIS_RADAR_WINDOW_HOURS=24
HARIS_RADAR_RETENTION_DAYS=30

# WhatsApp channel (Cloud API). Leave empty to turn it off.
# From Meta's App Dashboard > WhatsApp > API Setup: the access token and the Phone number ID.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# From App settings > Basic > App secret. Used to check that each webhook really comes from Meta.
WHATSAPP_APP_SECRET=
# Any long random text you choose; type the same text in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v26.0
