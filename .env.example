# Copy to .env and fill in. Never commit the real .env file.

# Optional: turns on the AI. Without a key Haris runs on rules only.
# Claude (Claude Console API key; Max plans include monthly API credits):
ANTHROPIC_API_KEY=
# or Gemini (free tier, key from https://aistudio.google.com/apikey):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: a second Gemini model with its own rate limit, used while the main one is paused (HTTP 429).
GEMINI_FALLBACK_MODEL=
# When both keys are set, choose one: anthropic or gemini.
HARIS_AI_PROVIDER=

# Optional: model used for the AI second opinion.
HARIS_MODEL=claude-haiku-5-5

# Optional: seconds to wait for the AI before falling back to rules (and for reading a screenshot or voice note).
HARIS_LLM_TIMEOUT=12
HARIS_LLM_IMAGE_TIMEOUT=30

# Requests per minute allowed per client on /api/*, and on the authority's API. 0 turns the limit off.
HARIS_RATE_LIMIT=30
HARIS_AUTHORITY_RATE_LIMIT=300

# Live website check: Haris opens a suspicious link safely and judges the page. 0 turns it off.
HARIS_SITE_CHECK=1
# Optional: a proxy for the visits (otherwise HTTPS_PROXY is used when set).
HARIS_SITE_PROXY=
# Optional: Google Safe Browsing threat lists (free key from Google Cloud; Web Risk for a production launch).
GOOGLE_SAFE_BROWSING_KEY=

# Campaign radar (demo). Reports are kept in data/radar.db, which is never committed.
# Without a token the authority dashboards (/authority.html, /reports.html) open only on this computer.
# Set a long random token before sharing Haris through a tunnel: it is then required everywhere.
HARIS_AUTHORITY_TOKEN=
HARIS_RADAR_WARN=3
HARIS_RADAR_ESCALATE=10
HARIS_RADAR_WINDOW_HOURS=24
HARIS_RADAR_RETENTION_DAYS=30

# Reports the victim sends to the authority (demo), kept in data/inbox.db, never committed.
# Deleted after this many days whatever their status. The same HARIS_AUTHORITY_TOKEN opens /reports.html.
HARIS_INBOX_RETENTION_DAYS=7

# WhatsApp channel (Cloud API). Leave empty to turn it off.
# From Meta's App Dashboard > WhatsApp > API Setup: the access token and the Phone number ID.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# From App settings > Basic > App secret. Used to check that each webhook really comes from Meta.
WHATSAPP_APP_SECRET=
# Any long random text you choose; type the same text in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v26.0
# Haris's public number and website, put on the contact card sent with the first welcome
WHATSAPP_PUBLIC_NUMBER=971503123535
HARIS_WEBSITE=https://claude.ai/artifact/Kb2rxU4cMeUmkumdnJZDkv

# Official warnings on WhatsApp. People subscribe by sending «تنبيهات» (ALERTS) and leave with «إيقاف» (STOP);
# their numbers are kept in data/alerts.db, never committed. Approving a campaign sends the warning to all of them.
# Outside 24 hours from a user's last message WhatsApp accepts only a Meta-approved template: give its name here,
# with two body variables ({{1}} the title, {{2}} the text), and the languages it was approved in.
WHATSAPP_ALERT_TEMPLATE=
WHATSAPP_ALERT_TEMPLATE_LANGS=ar,en

# Hosting. On Render, DATABASE_URL (PostgreSQL) keeps reports, subscribers and the radar across restarts;
# without it they stay in the local SQLite files above. Haris visits its own health page every 10 minutes
# so the free plan does not sleep; 0 turns that off.
DATABASE_URL=
HARIS_KEEP_AWAKE=1

# Benchmark scripts only (scripts/fetch_phishtank.py, scripts/fetch_phishstats.py). Not needed to run Haris.
PHISHTANK_APP_KEY=
PHISHTANK_USER=
PHISHSTATS_API_KEY=
