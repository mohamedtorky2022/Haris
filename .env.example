# Copy to .env and fill in. Never commit the real .env file.

# Optional: turns on the AI second opinion. Without it Haris runs on rules only.
ANTHROPIC_API_KEY=

# Optional: model used for the AI second opinion.
HARIS_MODEL=claude-haiku-5-5

# Optional: seconds to wait for the AI before falling back to rules.
HARIS_LLM_TIMEOUT=12

# Requests per minute allowed per client on /api/*. 0 turns the limit off.
HARIS_RATE_LIMIT=30
